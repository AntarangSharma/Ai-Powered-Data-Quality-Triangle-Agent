# Copy to .env and fill in.

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# Model selection — keep cheap by default; override per-stage if needed.
DQ_CLASSIFIER_MODEL=claude-haiku-4-5
DQ_NARRATOR_MODEL=claude-sonnet-4-5
DQ_LINEAGE_FALLBACK_MODEL=claude-haiku-4-5

# --- Storage ---
POSTGRES_DSN=postgresql+psycopg://dq:dq@localhost:5432/dq_triage

# --- Slack (optional for Week 1; webhook is fine until Week 5) ---
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#dq-incidents-dev

# --- Eval ---
DQ_EVAL_SEED=42
DQ_LLM_CACHE_DIR=.llm_cache
